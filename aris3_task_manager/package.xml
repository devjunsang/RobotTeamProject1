<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aris3_task_manager</name>
  <version>0.1.0</version>
  <description>ARIS3 Pick &amp; Place 작업 관리자 (C++17 ROS 2 액션 서버 + 상태 머신)</description>
  <maintainer email="demyank88@gmail.com">demyank</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>aris3_interfaces</depend>
  <depend>dsr_msgs2</depend>

  <exec_depend>aris3_sim_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
